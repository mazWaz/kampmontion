---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import PageHero from '../../../components/PageHero.astro';
import { SITE } from '../../../config/site';
import { organizationSchema, breadcrumb } from '../../../lib/schema';

const locale = 'en' as const;
const title = 'Blog — Motion Graphic, Animation & AI Insights';
const description = 'Articles and insights on motion graphics, 2D animation, video production, and AI workflows from the Kamp Motion Studio team.';
const jsonLd = [
  organizationSchema(locale),
  breadcrumb([
    { name: 'Home', url: SITE.url + '/en' },
    { name: 'Blog', url: SITE.url + '/en/blog' },
  ]),
];

const upcoming = [
  { title: '2D Animation vs Motion Graphics: Which Suits Your Brand?', cat: 'Education', read: '6 min', slug: '2d-animation-vs-motion-graphics' },
  { title: 'How AI Accelerates Video Production Without Killing Quality', cat: 'AI Workflow', read: '8 min', slug: 'ai-video-production' },
  { title: 'Choosing a Motion Graphic Studio for Your Startup', cat: 'Guide', read: '5 min', slug: 'choosing-motion-graphic-studio' },
  { title: 'Anatomy of a Company Profile Video That Sells', cat: 'Strategy', read: '7 min', slug: 'anatomy-company-profile-video' },
];
---
<BaseLayout {title} {description} {locale} path="/blog" {jsonLd} noindex>
  <PageHero
    title="Insights & inspiration from the studio."
    lead="Education and reflection from our journey blending creativity with AI. Slow rollout, quality first."
  />

  <section class="relative py-12 md:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <div class="flex items-baseline justify-between gap-4 mb-6">
          <h2 class="font-display font-bold text-2xl md:text-3xl tracking-tight">Coming soon</h2>
          <span class="text-sm text-white/60">{upcoming.length} articles</span>
        </div>
        <ul class="border-t border-[var(--color-line)]">
          {upcoming.map((u) => (
            <li class="border-b border-[var(--color-line)] py-6">
              <article>
                <p class="text-sm text-white/60">{u.cat}, {u.read} read</p>
                <h3 class="mt-2 font-display font-bold text-lg md:text-xl tracking-tight leading-snug">{u.title}</h3>
              </article>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="relative py-16 md:py-24 border-t border-[var(--color-line)]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="km-h2 max-w-2xl">Tell me when articles go live.</h2>
      <p class="mt-5 max-w-xl text-white/70">Subscribe and get articles first on publish — no spam, just one email per article.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={`mailto:${SITE.email}?subject=Subscribe%20Kamp%20Motion%20Blog`} class="km-btn-lime">
          <Icon name="mail" size={18} />
          Subscribe via email
        </a>
        <a href={SITE.social.instagram} target="_blank" rel="noopener" class="km-btn-ghost">Follow on Instagram</a>
      </div>
    </div>
  </section>
</BaseLayout>
