---
import type { Locale } from '../config/site';
import { clients } from '../data/clients';
export interface Props { locale: Locale }
const { locale } = Astro.props;
// Duplicate twice for seamless loop
const loop = [...clients, ...clients];
---
<section class="relative py-14 md:py-16 border-y border-[var(--color-line)] overflow-hidden">
  <p class="relative z-[2] text-center text-[10px] sm:text-xs font-display uppercase tracking-[0.3em] text-white/60 mb-10 px-4">
    {locale === 'id' ? `Dipercaya ${clients.length}+ klien · 7 tahun · Indonesia & Internasional` : `Trusted by ${clients.length}+ clients · 7 years · Indonesia & Worldwide`}
  </p>
  <div class="km-marquee">
    <div class="km-marquee-track km-client-track">
      {loop.map((c) => (
        <div class="km-client-cell" title={c.name}>
          <img src={`/assets/clients/${c.slug}.${c.ext}`} alt={c.name} width="320" height="320" loading="lazy" decoding="async" />
        </div>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .km-client-track { gap: 2.5rem; align-items: center; }
  .km-client-cell {
    flex: 0 0 auto;
    display: inline-flex; align-items: center; justify-content: center;
    padding: 14px 22px;
    background: rgba(255,255,255,0.85);
    backdrop-filter: blur(14px) saturate(160%);
    -webkit-backdrop-filter: blur(14px) saturate(160%);
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,0.4);
    box-shadow:
      0 1px 0 rgba(255,255,255,0.6) inset,
      0 8px 24px -10px rgba(0,0,0,0.4);
    transition: transform .25s, box-shadow .25s, background .25s, border-color .25s;
  }
  .km-client-cell:hover {
    transform: translateY(-2px) scale(1.04);
    background: rgba(255,255,255,0.95);
    border-color: rgba(216,242,46,0.6);
    box-shadow:
      0 1px 0 rgba(255,255,255,0.7) inset,
      0 16px 40px -10px rgba(216,242,46,0.3);
  }
  .km-client-cell img {
    height: 36px;
    width: auto;
    max-width: 140px;
    object-fit: contain;
    display: block;
  }
  @media (min-width: 768px) {
    .km-client-cell { padding: 16px 26px; border-radius: 16px; }
    .km-client-cell img { height: 48px; max-width: 170px; }
    .km-client-track { gap: 1.25rem; }
  }
</style>
