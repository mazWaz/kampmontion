---
import Icon from './Icon.astro';
export interface Props {
  title: string;
  lead?: string;
  size?: 'lg' | 'xl';
  /** Link to the parent page, shown above the title on detail pages. */
  back?: { href: string; label: string };
}
const { title, lead, size = 'xl', back } = Astro.props;
---
<section class="relative">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-20 md:pt-28 pb-16 md:pb-20">
    {back && (
      <a href={back.href} class="inline-flex items-center gap-2 text-sm text-white/70 hover:text-white transition-colors mb-6">
        <Icon name="arrow-left" size={16} />
        {back.label}
      </a>
    )}
    <h1 class:list={[size === 'xl' ? 'km-h1' : 'km-h2', 'max-w-5xl']}>{title}</h1>
    {lead && (
      <p class="mt-6 max-w-2xl text-lg md:text-xl text-white/70 leading-relaxed">{lead}</p>
    )}
    <slot />
  </div>
</section>
