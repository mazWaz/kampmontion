---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
import { organizationSchema, breadcrumb } from '../lib/schema';

const locale = 'id' as const;
const title = 'Kontak — Mulai Proyek Anda';
const description = `Hubungi Kamp Motion Studio di ${SITE.email} atau WhatsApp ${SITE.phoneDisplay} untuk konsultasi proyek motion graphic, animasi 2D, dan video produksi.`;
const jsonLd = [
  organizationSchema(locale),
  breadcrumb([
    { name: 'Beranda', url: SITE.url + '/' },
    { name: 'Kontak', url: SITE.url + '/kontak' },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Kontak Kamp Motion',
    url: SITE.url + '/kontak',
  },
];
---
<BaseLayout {title} {description} {locale} path="/kontak" {jsonLd}>
  <section class="bg-[var(--color-ink-2)] text-white py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <p class="text-sm uppercase tracking-widest text-[var(--color-lime)]">Kontak</p>
      <h1 class="mt-3 font-display text-4xl md:text-6xl font-bold">Mari Diskusikan Proyek Anda</h1>
      <p class="mt-4 text-white/75">Cerita singkat tentang kebutuhan Anda akan membantu kami memberikan estimasi yang tepat. Respon biasanya dalam 1–6 jam pada hari kerja.</p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-16 grid gap-6 md:grid-cols-2">
    <a href={SITE.whatsapp} target="_blank" rel="noopener" class="p-6 rounded-2xl border border-[var(--color-line)] hover:border-[var(--color-lime)] transition">
      <div class="text-2xl">💬</div>
      <div class="mt-3 font-display font-bold">WhatsApp</div>
      <div class="text-sm text-white/65 mt-1">{SITE.phoneDisplay}</div>
    </a>
    <a href={`mailto:${SITE.email}`} class="p-6 rounded-2xl border border-[var(--color-line)] hover:border-[var(--color-lime)] transition">
      <div class="text-2xl">✉️</div>
      <div class="mt-3 font-display font-bold">Email</div>
      <div class="text-sm text-white/65 mt-1">{SITE.email}</div>
    </a>
    <a href={SITE.social.instagram} target="_blank" rel="noopener" class="p-6 rounded-2xl border border-[var(--color-line)] hover:border-[var(--color-lime)] transition">
      <div class="text-2xl">📷</div>
      <div class="mt-3 font-display font-bold">Instagram</div>
      <div class="text-sm text-white/65 mt-1">@kamp_motion</div>
    </a>
    <a href={SITE.social.behance} target="_blank" rel="noopener" class="p-6 rounded-2xl border border-[var(--color-line)] hover:border-[var(--color-lime)] transition">
      <div class="text-2xl">🎨</div>
      <div class="mt-3 font-display font-bold">Behance</div>
      <div class="text-sm text-white/65 mt-1">Lihat portfolio lengkap</div>
    </a>
  </section>

  <section class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 pb-20">
    <div class="p-6 rounded-2xl bg-[var(--color-ink-2)] border border-[var(--color-line)] text-sm text-white/80">
      <strong>Studio:</strong> {SITE.address.locality}, {SITE.address.region}, {SITE.address.countryName}.
      <br/>Layanan tersedia untuk klien di seluruh Indonesia dan internasional secara remote.
    </div>
  </section>
</BaseLayout>
