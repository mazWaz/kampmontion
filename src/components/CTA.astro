---
import Icon from './Icon.astro';
import { t } from '../i18n/ui';
import { SITE } from '../config/site';
import type { Locale } from '../config/site';
export interface Props { locale: Locale }
const { locale } = Astro.props;
---
<section class="relative py-24 md:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="rounded-2xl border border-[var(--color-line-strong)] p-6 sm:p-10 md:p-16 bg-[var(--color-ink-2)]">
      <div class="max-w-3xl">
        <h2 class="km-h2">
          {locale === 'id' ? <>Bawa cerita Anda hidup.</> : <>Bring your story to life.</>}
        </h2>
        <p class="mt-6 text-lg text-white/70 max-w-xl">{t(locale,'home.ctaLead')}</p>
        <div class="mt-10 flex flex-wrap gap-3">
          <a href={SITE.whatsapp} target="_blank" rel="noopener" class="km-btn-lime">
            <Icon name="whatsapp" size={18} />
            {t(locale,'cta.discuss')}
          </a>
          <a href={`mailto:${SITE.email}`} class="km-btn-ghost">
            <Icon name="mail" size={18} />
            {SITE.email}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
