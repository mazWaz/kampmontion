---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import { SITE } from '../../../config/site';
import { organizationSchema, breadcrumb } from '../../../lib/schema';

const locale = 'en' as const;
const title = 'Blog — Motion Graphic, Animation & AI Insights';
const description = 'Articles and insights on motion graphics, 2D animation, video production, and AI workflows from the Kamp Motion Studio team.';
const jsonLd = [
  organizationSchema(locale),
  breadcrumb([
    { name: 'Home', url: SITE.url + '/en' },
    { name: 'Blog', url: SITE.url + '/en/blog' },
  ]),
];

const upcoming = [
  { title: '2D Animation vs Motion Graphics: Which Suits Your Brand?', cat: 'Education', read: '6 min', slug: '2d-animation-vs-motion-graphics' },
  { title: 'How AI Accelerates Video Production Without Killing Quality', cat: 'AI Workflow', read: '8 min', slug: 'ai-video-production' },
  { title: 'Choosing a Motion Graphic Studio for Your Startup', cat: 'Guide', read: '5 min', slug: 'choosing-motion-graphic-studio' },
  { title: 'Anatomy of a Company Profile Video That Sells', cat: 'Strategy', read: '7 min', slug: 'anatomy-company-profile-video' },
];
---
<BaseLayout {title} {description} {locale} path="/blog" {jsonLd}>
  <PageHero
    kicker="Blog"
    title="Insights & *inspiration* from the studio."
    lead="Education and reflection from our journey blending creativity with AI. Slow rollout, quality first."
  />

  <section class="relative py-12 md:py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between gap-4 mb-8">
        <h2 class="font-display font-bold text-2xl md:text-3xl tracking-tight">Upcoming</h2>
        <span class="text-xs font-display uppercase tracking-widest text-white/40">{upcoming.length} articles</span>
      </div>
      <ul class="grid gap-3">
        {upcoming.map((u, i) => (
          <li>
            <article class="km-bento p-6 md:p-7 flex flex-col md:flex-row md:items-center gap-4 md:gap-6">
              <div class="font-display text-3xl md:text-4xl font-bold text-[var(--color-lime)] tracking-tight w-14 flex-shrink-0">0{i+1}</div>
              <div class="flex-1 min-w-0">
                <div class="flex flex-wrap items-center gap-3 text-[10px] font-display uppercase tracking-widest text-white/50">
                  <span class="text-[var(--color-lime)]">{u.cat}</span>
                  <span class="w-1 h-1 rounded-full bg-white/30"></span>
                  <span>{u.read} read</span>
                  <span class="w-1 h-1 rounded-full bg-white/30"></span>
                  <span>Coming soon</span>
                </div>
                <h3 class="mt-2 font-display font-bold text-lg md:text-xl tracking-tight leading-snug">{u.title}</h3>
              </div>
              <span class="flex-shrink-0 inline-flex items-center gap-2 text-xs uppercase tracking-widest text-white/40 font-display">
                <span class="w-2 h-2 rounded-full bg-white/30"></span>
                Draft
              </span>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="relative py-16 md:py-24 border-t border-[var(--color-line)]">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="km-h2"><em>Updates</em> straight to inbox.</h2>
      <p class="mt-5 text-white/65">Subscribe and get articles first on publish — no spam, just one email per article.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={`mailto:${SITE.email}?subject=Subscribe%20Kamp%20Motion%20Blog`} data-cursor="link" class="km-btn-lime">
          Subscribe via Email
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href={SITE.social.instagram} target="_blank" rel="noopener" data-cursor="link" class="km-btn-ghost">Follow Instagram</a>
      </div>
    </div>
  </section>
</BaseLayout>
