---
export interface Props {
  kicker?: string;
  /** Main heading. Use `*word*` to wrap a word in lime accent (becomes <em>). */
  title: string;
  lead?: string;
  size?: 'lg' | 'xl';
}
const { kicker, title, lead, size = 'xl' } = Astro.props;

// Render *foo* → <em>foo</em>
const parts = title.split(/(\*[^*]+\*)/g);
const titleClass = size === 'xl' ? 'km-h1' : 'km-h2';
---
<section class="relative isolate overflow-hidden">
  <div class="km-aurora"></div>
  <div class="relative z-[2] mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-28 md:pt-36 pb-16 md:pb-24">
    {kicker && (
      <p class="text-xs md:text-sm font-display uppercase tracking-[0.25em] text-[var(--color-lime)]">
        {kicker}
      </p>
    )}
    <h1 class:list={[titleClass, kicker && 'mt-5']}>
      {parts.map((p) =>
        p.startsWith('*') && p.endsWith('*') ? <em>{p.slice(1, -1)}</em> : <Fragment set:html={p} />
      )}
    </h1>
    {lead && (
      <p class="mt-6 max-w-2xl text-lg md:text-xl text-white/70 leading-relaxed">{lead}</p>
    )}
    <slot />
  </div>
</section>
