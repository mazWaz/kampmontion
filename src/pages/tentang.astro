---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import Process from '../components/Process.astro';
import { team } from '../data/team';
import { SITE } from '../config/site';
import { organizationSchema, breadcrumb } from '../lib/schema';

const locale = 'id' as const;
const title = 'Tentang Kamp Motion Studio';
const description = 'Kamp Motion adalah studio kreatif berbasis di Yogyakarta, Indonesia. 7+ tahun berpengalaman, 50+ klien, dengan workflow yang menggabungkan kreativitas manusia dan AI.';
const jsonLd = [
  organizationSchema(locale),
  breadcrumb([
    { name: 'Beranda', url: SITE.url + '/' },
    { name: 'Tentang', url: SITE.url + '/tentang' },
  ]),
];
---
<BaseLayout {title} {description} {locale} path="/tentang" {jsonLd}>
  <section class="bg-[var(--color-ink-2)] text-white py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <p class="text-sm uppercase tracking-widest text-[var(--color-lime)]">Tentang Kami</p>
      <h1 class="mt-3 font-display text-4xl md:text-6xl font-bold">Where Imagination Comes to Life</h1>
      <p class="mt-6 text-lg text-white/75">Kamp Motion Studio adalah studio kreatif Indonesia yang fokus pada animasi 2D, motion graphic, dan video produksi. Berdiri sejak {SITE.founded}, kami telah mendukung lebih dari 50 brand lokal dan internasional dalam menyampaikan cerita visual mereka — dari startup teknologi hingga korporat dan NGO.</p>
      <p class="mt-4 text-lg text-white/75">Kami percaya bahwa kombinasi kreativitas manusia dengan kecerdasan buatan menghasilkan karya yang lebih cepat, presisi, dan tetap punya jiwa.</p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-20">
    <h2 class="font-display text-3xl md:text-4xl font-bold">Tim Kami</h2>
    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {team.map((m) => (
        <div class="p-6 rounded-2xl border border-[var(--color-line)] bg-[var(--color-ink-2)]">
          <div class="w-16 h-16 rounded-full bg-[var(--color-lime)] flex items-center justify-center text-[#0a0a0b] font-display font-bold text-2xl">
            {m.name.charAt(0)}
          </div>
          <div class="mt-4 font-display font-bold text-lg">{m.name}</div>
          <div class="text-sm text-[var(--color-lime)]">{m.role.id}</div>
          <p class="mt-2 text-sm text-white/65">{m.bio.id}</p>
        </div>
      ))}
    </div>
  </section>

  <Process locale={locale} />
  <CTA locale={locale} />
</BaseLayout>
