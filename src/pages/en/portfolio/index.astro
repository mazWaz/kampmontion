---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import PageHero from '../../../components/PageHero.astro';
import CTA from '../../../components/CTA.astro';
import { projects } from '../../../data/portfolio';
import { SITE } from '../../../config/site';
import { organizationSchema, breadcrumb } from '../../../lib/schema';

const locale = 'en' as const;
const title = 'Animation & Motion Graphic Portfolio';
const description = 'Selected work from Kamp Motion Studio: 2D animation, motion graphics, company profile videos, event bumpers, logo animation, and VFX for local and international brands.';
const jsonLd = [
  organizationSchema(locale),
  breadcrumb([
    { name: 'Home', url: SITE.url + '/en' },
    { name: 'Portfolio', url: SITE.url + '/en/portfolio' },
  ]),
];
---
<BaseLayout {title} {description} {locale} path="/portfolio" {jsonLd}>
  <PageHero
    title="Selected work for 50+ clients."
    lead="From animated explainers to TikTok event bumpers — work we can share publicly."
  />
  <section class="relative py-12 md:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-x-5 gap-y-12 md:grid-cols-2 lg:grid-cols-3">
        {projects.map((p, i) => <ProjectCard project={p} {locale} eager={i < 3} heading="h2" summary />)}
      </div>
    </div>
  </section>
  <CTA locale={locale} />
</BaseLayout>
