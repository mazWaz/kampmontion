---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTA from '../../components/CTA.astro';
import { services } from '../../data/services';
import { SITE } from '../../config/site';
import { organizationSchema, breadcrumb, faqSchema } from '../../lib/schema';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}

const { service } = Astro.props;
const locale = 'id' as const;
const title = `${service.title.id} — Jasa Profesional`;
const description = service.short.id;
const url = `${SITE.url}/layanan/${service.slug}`;

const faqs = [
  { question: `Berapa lama proses pengerjaan ${service.title.id}?`, answer: 'Bergantung kompleksitas: 5–14 hari kerja untuk proyek standar, 2–6 minggu untuk proyek besar atau kustom.' },
  { question: `Apakah ${service.title.id} sudah termasuk revisi?`, answer: 'Ya, setiap paket termasuk revisi sesuai scope yang disepakati. Revisi tambahan tersedia dengan biaya proporsional.' },
  { question: 'Apakah Kamp Motion bisa menangani proyek internasional?', answer: 'Tentu. Kami sudah melayani klien lokal dan internasional dengan komunikasi via email, WhatsApp, atau video call.' },
  { question: 'Bagaimana sistem pembayaran proyek?', answer: 'Standar industri: 50% di awal sebagai DP setelah brief disepakati, 50% setelah delivery final. Untuk paket langganan, billing dilakukan bulanan.' },
];

const related = services.filter((s) => s.slug !== service.slug).slice(0, 3);

const jsonLd = [
  organizationSchema(locale),
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: service.title.id,
    serviceType: service.title.id,
    description: service.long.id,
    provider: { '@id': `${SITE.url}#organization` },
    areaServed: ['Indonesia', 'Worldwide'],
    url,
    offers: { '@type': 'Offer', priceCurrency: 'IDR', availability: 'https://schema.org/InStock' },
  },
  faqSchema(faqs),
  breadcrumb([
    { name: 'Beranda', url: SITE.url + '/' },
    { name: 'Layanan', url: SITE.url + '/layanan' },
    { name: service.title.id, url },
  ]),
];
---
<BaseLayout {title} {description} {locale} path={`/layanan/${service.slug}`} {jsonLd}>
  <PageHero kicker="Layanan" title={service.title.id} lead={service.short.id}>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href={SITE.whatsapp} target="_blank" rel="noopener" data-magnetic="0.25" data-cursor="link" class="km-btn-lime">
        Diskusi via WhatsApp
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
      <a href="/#brief" data-cursor="link" class="km-btn-ghost">Buat Brief Otomatis</a>
    </div>
  </PageHero>

  <div class="relative -mt-4">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="aspect-video rounded-3xl overflow-hidden border border-[var(--color-line)] bg-[var(--color-ink-2)]">
        <img src={service.image} alt={`${service.title.id} — Kamp Motion Studio`} class="w-full h-full object-cover" width="1200" height="675" loading="eager" />
      </div>
    </div>
  </div>

  <section class="relative py-20 md:py-28 border-t border-[var(--color-line)]">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 grid lg:grid-cols-[1.4fr_1fr] gap-10 lg:gap-16">
      <article class="order-2 lg:order-1">
        <h2 class="km-h2">
          <em>Apa</em> yang kami kerjakan
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-white/75">{service.long.id}</p>
      </article>

      <aside class="order-1 lg:order-2 lg:sticky lg:top-24 self-start">
        <div class="rounded-3xl border border-[var(--color-line)] bg-[var(--color-ink-2)] p-6 md:p-8">
          <div class="text-xs font-display uppercase tracking-widest text-[var(--color-lime)]">Yang Anda Dapatkan</div>
          <ul class="mt-5 space-y-3">
            {service.deliverables.id.map((d: string) => (
              <li class="flex gap-3 text-sm text-white/85 leading-relaxed">
                <span class="mt-0.5 flex-shrink-0 w-5 h-5 rounded-full bg-[var(--color-lime)] grid place-items-center">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#0a0a0b" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                </span>
                <span>{d}</span>
              </li>
            ))}
          </ul>
          <div class="mt-6 pt-5 border-t border-[var(--color-line)] text-xs text-white/50">
            Estimasi standar 2–3 minggu kerja. Detail timeline disesuaikan brief.
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="relative py-20 md:py-28 border-t border-[var(--color-line)]">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <h2 class="km-h2 max-w-2xl">
        Pertanyaan <em>umum</em>.
      </h2>
      <div class="mt-10 grid gap-3 max-w-3xl">
        {faqs.map((f) => (
          <details class="group rounded-2xl border border-[var(--color-line)] bg-[var(--color-ink-2)] open:border-[var(--color-lime)]/40 transition">
            <summary class="cursor-pointer list-none p-5 md:p-6 flex items-center justify-between gap-4 font-display font-semibold text-base md:text-lg">
              <span>{f.question}</span>
              <span class="flex-shrink-0 w-8 h-8 rounded-full border border-[var(--color-line-strong)] grid place-items-center transition group-open:bg-[var(--color-lime)] group-open:border-[var(--color-lime)] group-open:text-[#0a0a0b]">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition group-open:rotate-45"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              </span>
            </summary>
            <p class="px-5 md:px-6 pb-5 md:pb-6 text-white/65 leading-relaxed">{f.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="relative py-20 md:py-28 border-t border-[var(--color-line)]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between gap-6 mb-10 flex-wrap">
        <h2 class="km-h2 max-w-2xl">
          Layanan <em>terkait</em>.
        </h2>
        <a href="/layanan" data-cursor="link" class="km-link text-sm uppercase tracking-widest text-white/60 hover:text-[var(--color-lime)] font-display">Semua layanan →</a>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        {related.map((r) => (
          <a href={`/layanan/${r.slug}`} data-spotlight data-cursor="link" class="km-bento overflow-hidden flex flex-col">
            <div class="aspect-video overflow-hidden bg-[var(--color-ink-3)]">
              <img src={r.image} alt={r.title.id} class="w-full h-full object-cover transition duration-500 group-hover:scale-105" width="1200" height="675" loading="lazy" />
            </div>
            <div class="p-6">
              <h3 class="font-display font-bold text-xl tracking-tight">{r.title.id}</h3>
              <p class="mt-2 text-sm text-white/60 line-clamp-2">{r.short.id}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTA locale={locale} />
</BaseLayout>
