---
import Icon from './Icon.astro';
import { services } from '../data/services';
import { t } from '../i18n/ui';
import type { Locale } from '../config/site';
export interface Props { locale: Locale; heading?: boolean }
const { locale, heading = true } = Astro.props;

// Bento: first card spans 2 cols on lg
const sizes = [
  'lg:col-span-2 lg:row-span-2', '', '',
  'lg:col-span-2', '', '',
  '', '',
];
---
<section class:list={['relative', heading ? 'py-24 md:py-32' : 'pb-24 md:pb-32']}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    {heading && (
      <div class="flex flex-wrap items-end justify-between gap-6 mb-12">
        <h2 class="km-h2 max-w-2xl">
          {locale === 'id' ? 'Delapan layanan, satu studio.' : 'Eight services, one studio.'}
        </h2>
        <a href={locale==='id'?'/layanan':'/en/services'} class="km-link text-sm text-white/70 hover:text-white">
          {locale === 'id' ? 'Semua layanan' : 'All services'}
        </a>
      </div>
    )}

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 auto-rows-[200px] gap-4">
      {services.map((s, i) => (
        <a href={locale==='id'?`/layanan/${s.slug}`:`/en/services/${s.slugEn}`}

           class={`km-bento km-svc-card group ${sizes[i] || ''}`}>
          <img src={s.image} alt="" width="1200" height="800" loading="lazy" decoding="async" class="km-svc-img" />
          <div class="km-svc-overlay"></div>
          <span class="km-svc-arrow">
            <Icon name="arrow-up-right" size={20} />
          </span>
          <div class="km-svc-content">
            <h3>{s.title[locale]}</h3>
            {sizes[i]?.includes('col-span-2') && (
              <p>{s.short[locale]}</p>
            )}
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .km-svc-card { position: relative; overflow: hidden; isolation: isolate; display: block; }
  .km-svc-img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; opacity: 0.75;
    transition: opacity .3s;
    z-index: 0;
  }
  .km-svc-card:hover .km-svc-img { opacity: 1; }
  .km-svc-overlay {
    position: absolute; inset: 0;
    /* Dark only where the text sits, so the still stays visible. */
    background: linear-gradient(to top, rgba(10,10,11,.92) 0%, rgba(10,10,11,.6) 38%, rgba(10,10,11,0) 70%);
    z-index: 1;
  }
  .km-svc-arrow {
    position: absolute; top: 1.25rem; right: 1.5rem;
    z-index: 3; color: var(--color-lime);
    opacity: 0; transition: opacity .25s;
  }
  .km-svc-card:hover .km-svc-arrow { opacity: 1; }
  .km-svc-content {
    position: absolute; left: 1.5rem; right: 1.5rem; bottom: 1.25rem;
    z-index: 3; color: #ffffff;
  }
  .km-svc-content h3 {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(1.25rem, 2.2vw, 1.875rem);
    line-height: 1.05; letter-spacing: -0.02em;
        margin: 0;
  }
  .km-svc-content p {
    margin: .75rem 0 0;
    font-size: .9rem; line-height: 1.5;
    color: rgba(255,255,255,0.85);
    max-width: 28rem;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
