---
import { testimonials } from '../data/testimonials';
import { t } from '../i18n/ui';
import type { Locale } from '../config/site';
export interface Props { locale: Locale }
const { locale } = Astro.props;
---
<section class="relative py-24 md:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex items-end justify-between gap-6 mb-12 flex-wrap">
      <div>
        <span class="km-eyebrow">07 · {locale === 'id' ? 'Klien Berkata' : 'Voices'}</span>
        <h2 class="km-h2 mt-4 max-w-2xl">
          {locale === 'id' ? <>Bukti nyata dari <em>50+</em> klien.</> : <>Real proof from <em>50+</em> clients.</>}
        </h2>
      </div>
      <div class="flex items-center gap-2 text-white/60">
        <span class="text-[var(--color-lime)] text-xl">★★★★★</span>
        <span class="text-sm">5.0 / Fastwork · Sribu</span>
      </div>
    </div>

    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {testimonials.map((tm, i) => (
        <figure data-spotlight class="km-bento p-7 flex flex-col gap-4 min-h-[200px]">
          <div class="flex items-center justify-between">
            <span class="text-[var(--color-lime)] text-sm">★★★★★</span>
            <span class="text-[10px] font-display tracking-widest uppercase text-white/40">0{i+1} · {tm.source}</span>
          </div>
          <blockquote class="text-base md:text-lg leading-relaxed text-white/85">"{tm.quote}"</blockquote>
          <figcaption class="mt-auto pt-3 border-t border-[var(--color-line)] text-xs text-white/50">
            <span class="text-white font-semibold">{tm.author}</span> · {tm.role}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
