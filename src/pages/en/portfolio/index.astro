---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import CTA from '../../../components/CTA.astro';
import { projects } from '../../../data/portfolio';
import { SITE } from '../../../config/site';
import { organizationSchema, breadcrumb } from '../../../lib/schema';

const locale = 'en' as const;
const title = 'Animation & Motion Graphic Portfolio';
const description = 'Selected work from Kamp Motion Studio: 2D animation, motion graphics, company profile videos, event bumpers, logo animation, and VFX for local and international brands.';
const jsonLd = [
  organizationSchema(locale),
  breadcrumb([
    { name: 'Home', url: SITE.url + '/en' },
    { name: 'Portfolio', url: SITE.url + '/en/portfolio' },
  ]),
];
---
<BaseLayout {title} {description} {locale} path="/portfolio" {jsonLd}>
  <PageHero
    kicker="Portfolio"
    title="Selected work for *50+* clients."
    lead="From fintech onboarding to corporate cinematic — work we can share publicly."
  />
  <section class="relative py-12 md:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {projects.map((p, i) => (
          <a href={`/en/portfolio/${p.slug}`} data-spotlight data-cursor="play"
             class="group block rounded-2xl overflow-hidden border border-[var(--color-line)] hover:border-[var(--color-lime)] bg-[var(--color-ink-2)] transition">
            <div class="aspect-video overflow-hidden bg-[var(--color-ink-3)] relative">
              <img src={p.cover} alt={p.title.en} class="w-full h-full object-cover transition duration-500 group-hover:scale-105" width="800" height="450" loading={i < 3 ? "eager" : "lazy"} />
              <div class="absolute top-3 left-3 px-2.5 py-1 rounded-full bg-black/60 backdrop-blur text-[10px] uppercase tracking-widest font-display">
                {p.year}
              </div>
            </div>
            <div class="p-5">
              <div class="text-xs uppercase tracking-widest text-[var(--color-lime)] font-display">{p.category.en}</div>
              <h2 class="mt-2 font-display font-bold text-lg tracking-tight">{p.title.en}</h2>
              <p class="mt-1 text-sm text-white/60 line-clamp-2">{p.summary.en}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  <CTA locale={locale} />
</BaseLayout>
