---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTA from '../../components/CTA.astro';
import { services } from '../../data/services';
import { SITE } from '../../config/site';
import { organizationSchema, breadcrumb, faqSchema } from '../../lib/schema';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}

const { service } = Astro.props;
const locale = 'id' as const;
const title = `${service.title.id} — Jasa Profesional`;
const description = service.short.id;
const url = `${SITE.url}/layanan/${service.slug}`;

const faqs = [
  {
    question: `Berapa lama proses pengerjaan ${service.title.id}?`,
    answer: 'Bergantung kompleksitas: 5–14 hari kerja untuk proyek standar, 2–6 minggu untuk proyek besar atau kustom.',
  },
  {
    question: `Apakah ${service.title.id} sudah termasuk revisi?`,
    answer: 'Ya, setiap paket termasuk revisi sesuai scope yang disepakati. Revisi tambahan tersedia dengan biaya proporsional.',
  },
  {
    question: 'Apakah Kamp Motion bisa menangani proyek internasional?',
    answer: 'Tentu. Kami sudah melayani klien lokal dan internasional dengan komunikasi via email, WhatsApp, atau video call.',
  },
];

const jsonLd = [
  organizationSchema(locale),
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: service.title.id,
    serviceType: service.title.id,
    description: service.long.id,
    provider: { '@id': `${SITE.url}#organization` },
    areaServed: ['Indonesia', 'Worldwide'],
    url,
    offers: { '@type': 'Offer', priceCurrency: 'IDR', availability: 'https://schema.org/InStock' },
  },
  faqSchema(faqs),
  breadcrumb([
    { name: 'Beranda', url: SITE.url + '/' },
    { name: 'Layanan', url: SITE.url + '/layanan' },
    { name: service.title.id, url },
  ]),
];
---
<BaseLayout {title} {description} {locale} path={`/layanan/${service.slug}`} {jsonLd}>
  <section class="bg-[var(--color-ink-2)] text-white py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <p class="text-sm uppercase tracking-widest text-[var(--color-lime)]">Layanan</p>
      <h1 class="mt-3 font-display text-4xl md:text-6xl font-bold">{service.title.id}</h1>
      <p class="mt-4 text-lg text-white/75">{service.short.id}</p>
    </div>
  </section>

  <article class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-16 prose prose-neutral max-w-none">
    <p class="text-lg leading-relaxed text-white/80">{service.long.id}</p>

    <h2 class="mt-12 font-display text-2xl font-bold">Yang Anda Dapatkan</h2>
    <ul class="mt-4 space-y-2">
      {service.deliverables.id.map((d: string) => (
        <li class="flex gap-2"><span class="text-[var(--color-lime)]">✓</span><span>{d}</span></li>
      ))}
    </ul>

    <h2 class="mt-12 font-display text-2xl font-bold">Pertanyaan Umum</h2>
    <div class="mt-4 space-y-4">
      {faqs.map((f) => (
        <details class="group p-5 rounded-xl border border-[var(--color-line)] bg-[var(--color-ink-2)]">
          <summary class="cursor-pointer font-semibold">{f.question}</summary>
          <p class="mt-3 text-white/65">{f.answer}</p>
        </details>
      ))}
    </div>
  </article>

  <CTA locale={locale} />
</BaseLayout>
