---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { Locale } from '../config/site';
export interface Props { slug: string; title: string; locale: Locale }
const { slug, title, locale } = Astro.props;

// Stills live in src/assets/gallery/<service slug>/"NN Caption.jpg": NN sets the order, the rest is the caption.
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/gallery/*/*.jpg', { eager: true });
const items = Object.entries(files)
  .filter(([path]) => path.includes(`/gallery/${slug}/`))
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => ({ img: mod.default, caption: path.split('/').pop()!.replace(/^\d+ /, '').replace(/\.jpg$/, '') }));
---
{items.length > 0 && (
  <section class="relative py-20 md:py-28 border-t border-[var(--color-line)]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="km-h2 max-w-2xl">
        {locale === 'id' ? 'Cuplikan karya.' : 'Work highlights.'}
      </h2>
      <div class="mt-10 columns-1 sm:columns-2 lg:columns-3 gap-5">
        {items.map(({ img, caption }) => (
          <figure class="mb-8 break-inside-avoid">
            <Image src={img} alt={`${title} — ${caption}`} widths={[400, 800, 1200]}
              sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw" class="w-full h-auto rounded-2xl border border-[var(--color-line)]" />
            <figcaption class="mt-3 text-sm text-white/70">{caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
