---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTA from '../components/CTA.astro';
import Process from '../components/Process.astro';
import { team } from '../data/team';
import { SITE } from '../config/site';
import { organizationSchema, breadcrumb } from '../lib/schema';

const locale = 'id' as const;
const title = 'Tentang Kamp Motion Studio';
const description = 'Kamp Motion adalah studio kreatif berbasis di Yogyakarta, Indonesia. 7+ tahun berpengalaman, 50+ klien, dengan workflow yang menggabungkan kreativitas manusia dan AI.';
const jsonLd = [
  organizationSchema(locale),
  breadcrumb([
    { name: 'Beranda', url: SITE.url + '/' },
    { name: 'Tentang', url: SITE.url + '/tentang' },
  ]),
];

const values = [
  { title: 'Storytelling First', desc: 'Visual cantik percuma tanpa cerita. Setiap proyek dimulai dari narasi yang jelas.' },
  { title: 'AI sebagai Akselerator', desc: 'Bukan pengganti kreator. Kami pakai AI untuk speed-up iterasi, bukan auto-pilot kreativitas.' },
  { title: 'Detail yang Tidak Terlihat', desc: 'Sound design, motion easing, micro-typography — hal yang ditangkap mata bawah sadar.' },
  { title: 'Komunikasi Tanpa Tele-tele', desc: 'Brief jelas, milestone tegas, revisi terstruktur. Hasil tepat waktu.' },
];
---
<BaseLayout {title} {description} {locale} path="/tentang" {jsonLd}>
  <PageHero
    kicker="Tentang Kami"
    title="Where *Imagination* Comes to Life."
    lead={`Kamp Motion Studio adalah studio kreatif Indonesia yang fokus pada animasi 2D, motion graphic, dan video produksi. Berdiri sejak ${SITE.founded}, kami telah mendukung 50+ brand lokal dan internasional dalam menyampaikan cerita visual mereka.`}
  />

  <section class="relative py-20 md:py-28 border-t border-[var(--color-line)]">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-10 lg:gap-16 items-start">
      <h2 class="km-h2"><em>Cerita</em> kami.</h2>
      <div class="space-y-5 text-lg text-white/75 leading-relaxed">
        <p>Berawal dari pekerjaan freelance di Behance dan Fastwork, Kamp Motion berkembang menjadi studio dengan 4 anggota inti dan jaringan kolaborator lepas — videografer, ilustrator, voice artist, dan sound designer.</p>
        <p>Kami percaya bahwa kombinasi kreativitas manusia dengan kecerdasan buatan menghasilkan karya yang lebih cepat, presisi, dan tetap punya jiwa.</p>
        <p>Hari ini kami melayani klien dari sektor perbankan, teknologi, edukasi, kesehatan, NGO, dan instansi pemerintah — dari Yogyakarta untuk Indonesia, untuk dunia.</p>
      </div>
    </div>
  </section>

  <section class="relative py-20 md:py-28 border-t border-[var(--color-line)]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="km-h2 max-w-2xl">Yang kami <em>pegang</em>.</h2>
      <div class="mt-12 grid gap-px bg-[var(--color-line)] border border-[var(--color-line)] rounded-2xl overflow-hidden md:grid-cols-2">
        {values.map((v, i) => (
          <div class="bg-[var(--color-ink)] p-8 hover:bg-[var(--color-ink-2)] transition">
            <div class="font-display text-3xl font-bold text-[var(--color-lime)] tracking-tight">0{i+1}</div>
            <h3 class="mt-5 font-display font-bold text-xl tracking-tight">{v.title}</h3>
            <p class="mt-3 text-white/60 leading-relaxed">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="relative py-20 md:py-28 border-t border-[var(--color-line)]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between gap-6 mb-12 flex-wrap">
        <h2 class="km-h2 max-w-2xl">Tim <em>inti</em>.</h2>
        <span class="text-xs uppercase tracking-widest text-white/40 font-display">Yogyakarta · Indonesia</span>
      </div>
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {team.map((m) => (
          <div data-spotlight class="km-bento p-6 md:p-7 flex flex-col min-h-[220px]">
            <div class="w-14 h-14 rounded-2xl bg-[var(--color-lime)] flex items-center justify-center text-[#0a0a0b] font-display font-bold text-2xl">
              {m.name.charAt(0)}
            </div>
            <div class="mt-auto pt-6">
              <div class="font-display font-bold text-xl tracking-tight">{m.name}</div>
              <div class="mt-1 text-xs uppercase tracking-widest text-[var(--color-lime)] font-display">{m.role.id}</div>
              <p class="mt-3 text-sm text-white/60 leading-relaxed">{m.bio.id}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Process locale={locale} />
  <CTA locale={locale} />
</BaseLayout>
