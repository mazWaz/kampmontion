---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTA from '../../components/CTA.astro';
import Process from '../../components/Process.astro';
import { team } from '../../data/team';
import { SITE } from '../../config/site';
import { organizationSchema, breadcrumb } from '../../lib/schema';

const locale = 'en' as const;
const title = 'About Kamp Motion Studio';
const description = 'Kamp Motion is a Yogyakarta-based creative studio with 7+ years of experience and 50+ clients, blending human creativity with AI in every workflow.';
const jsonLd = [
  organizationSchema(locale),
  breadcrumb([
    { name: 'Home', url: SITE.url + '/en' },
    { name: 'About', url: SITE.url + '/en/about' },
  ]),
];

const values = [
  { title: 'Storytelling First', desc: 'Beautiful visuals are wasted without a story. Every project starts from a clear narrative.' },
  { title: 'AI as Accelerator', desc: 'Not a creator replacement. We use AI to speed up iteration, not to autopilot creativity.' },
  { title: 'Invisible Details', desc: 'Sound design, motion easing, micro-typography — what your subconscious notices.' },
  { title: 'No-Nonsense Communication', desc: 'Clear briefs, firm milestones, structured revisions. On-time delivery.' },
];
---
<BaseLayout {title} {description} {locale} path="/about" {jsonLd}>
  <PageHero
    kicker="About Us"
    title="Where *Imagination* Comes to Life."
    lead={`Kamp Motion Studio is an Indonesian creative studio focused on 2D animation, motion graphics, and video production. Since ${SITE.founded}, we have supported 50+ local and international brands in telling their visual stories.`}
  />

  <section class="relative py-20 md:py-28 border-t border-[var(--color-line)]">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-10 lg:gap-16 items-start">
      <h2 class="km-h2">Our <em>story</em>.</h2>
      <div class="space-y-5 text-lg text-white/75 leading-relaxed">
        <p>Starting from freelance work on Behance and Fastwork, Kamp Motion grew into a studio of 4 core members and a network of collaborators — videographers, illustrators, voice artists, and sound designers.</p>
        <p>We believe combining human creativity with AI delivers work that is faster, sharper, and still has soul.</p>
        <p>Today we serve clients across banking, technology, education, healthcare, NGOs, and government — from Yogyakarta to Indonesia, to the world.</p>
      </div>
    </div>
  </section>

  <section class="relative py-20 md:py-28 border-t border-[var(--color-line)]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="km-h2 max-w-2xl">What we <em>stand for</em>.</h2>
      <div class="mt-12 grid gap-px bg-[var(--color-line)] border border-[var(--color-line)] rounded-2xl overflow-hidden md:grid-cols-2">
        {values.map((v, i) => (
          <div class="bg-[var(--color-ink)] p-8 hover:bg-[var(--color-ink-2)] transition">
            <div class="font-display text-3xl font-bold text-[var(--color-lime)] tracking-tight">0{i+1}</div>
            <h3 class="mt-5 font-display font-bold text-xl tracking-tight">{v.title}</h3>
            <p class="mt-3 text-white/60 leading-relaxed">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="relative py-20 md:py-28 border-t border-[var(--color-line)]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between gap-6 mb-12 flex-wrap">
        <h2 class="km-h2 max-w-2xl">Core <em>team</em>.</h2>
        <span class="text-xs uppercase tracking-widest text-white/40 font-display">Yogyakarta · Indonesia</span>
      </div>
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {team.map((m) => (
          <div data-spotlight class="km-bento p-6 md:p-7 flex flex-col min-h-[220px]">
            <div class="w-14 h-14 rounded-2xl bg-[var(--color-lime)] flex items-center justify-center text-[#0a0a0b] font-display font-bold text-2xl">
              {m.name.charAt(0)}
            </div>
            <div class="mt-auto pt-6">
              <div class="font-display font-bold text-xl tracking-tight">{m.name}</div>
              <div class="mt-1 text-xs uppercase tracking-widest text-[var(--color-lime)] font-display">{m.role.en}</div>
              <p class="mt-3 text-sm text-white/60 leading-relaxed">{m.bio.en}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Process locale={locale} />
  <CTA locale={locale} />
</BaseLayout>
