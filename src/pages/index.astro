---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import SelectedWork from '../components/SelectedWork.astro';
import Process from '../components/Process.astro';
import Testimonials from '../components/Testimonials.astro';
import CTA from '../components/CTA.astro';
import ClientLogos from '../components/ClientLogos.astro';
import BriefGenerator from '../components/BriefGenerator.astro';
import { SITE } from '../config/site';
import { organizationSchema, websiteSchema, serviceSchema, breadcrumb } from '../lib/schema';

const locale = 'id' as const;
const title = `${SITE.name} — ${SITE.tagline.id}`;
const description = SITE.description.id;
const jsonLd = [
  organizationSchema(locale),
  websiteSchema(locale),
  ...serviceSchema(locale),
  breadcrumb([{ name: 'Beranda', url: SITE.url + '/' }]),
];
---
<BaseLayout {title} {description} {locale} path="/" {jsonLd}>
  <Hero locale={locale} />
  <ClientLogos locale={locale} />
  <SelectedWork locale={locale} />
  <ServicesGrid locale={locale} />
  <Process locale={locale} />
  <BriefGenerator locale={locale} />
  <Testimonials locale={locale} />
  <CTA locale={locale} />
</BaseLayout>
