---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SITE } from '../../../config/site';
import { organizationSchema, breadcrumb } from '../../../lib/schema';

const locale = 'en' as const;
const title = 'Blog — Motion Graphic, Animation & AI Insights';
const description = 'Articles and insights on motion graphics, 2D animation, video production, and AI workflows from the Kamp Motion Studio team.';
const jsonLd = [
  organizationSchema(locale),
  breadcrumb([
    { name: 'Home', url: SITE.url + '/en' },
    { name: 'Blog', url: SITE.url + '/en/blog' },
  ]),
];
const upcoming = [
  { title: '2D Animation vs Motion Graphics: Which Suits Your Brand?', slug: '2d-animation-vs-motion-graphics' },
  { title: 'How AI Accelerates Video Production Without Killing Quality', slug: 'ai-video-production' },
  { title: 'Choosing a Motion Graphic Studio for Your Startup', slug: 'choosing-motion-graphic-studio' },
  { title: 'Anatomy of a Company Profile Video That Sells', slug: 'anatomy-company-profile-video' },
];
---
<BaseLayout {title} {description} {locale} path="/blog" {jsonLd}>
  <section class="bg-[var(--color-ink-2)] text-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="text-sm uppercase tracking-widest text-[var(--color-lime)]">Blog</p>
      <h1 class="mt-3 font-display text-4xl md:text-6xl font-bold">Insights & Inspiration</h1>
      <p class="mt-4 max-w-2xl text-white/70">Education and reflections from our journey blending creativity with AI.</p>
    </div>
  </section>
  <section class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-16">
    <h2 class="font-display text-2xl font-bold">Upcoming</h2>
    <ul class="mt-6 space-y-3">
      {upcoming.map((u) => (
        <li class="p-5 rounded-xl border border-[var(--color-line)] bg-[var(--color-ink-2)]">
          <span class="text-xs uppercase tracking-wider text-white/40">Coming soon</span>
          <div class="mt-1 font-display font-bold text-lg">{u.title}</div>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
