---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { SITE } from '../../config/site';
import { organizationSchema, breadcrumb } from '../../lib/schema';

const locale = 'en' as const;
const title = 'Contact — Start Your Project';
const description = `Contact Kamp Motion Studio at ${SITE.email} or WhatsApp ${SITE.phoneDisplay} for motion graphic, 2D animation, and video production projects.`;
const jsonLd = [
  organizationSchema(locale),
  breadcrumb([
    { name: 'Home', url: SITE.url + '/en' },
    { name: 'Contact', url: SITE.url + '/en/contact' },
  ]),
  { '@context': 'https://schema.org', '@type': 'ContactPage', name: 'Contact Kamp Motion', url: SITE.url + '/en/contact' },
];

const channels = [
  {
    label: 'WhatsApp',
    icon: 'whatsapp',
    value: SITE.phoneDisplay,
    sub: 'Reply within 1–6 hours on business days',
    href: SITE.whatsapp,
    external: true,
    primary: true,
  },
  {
    label: 'Email',
    icon: 'mail',
    value: SITE.email,
    sub: 'For full briefs & attachments',
    href: `mailto:${SITE.email}`,
    external: false,
    primary: false,
  },
  {
    label: 'Instagram',
    icon: 'instagram',
    value: '@kamp_motion',
    sub: 'Latest work & behind-the-scenes',
    href: SITE.social.instagram,
    external: true,
    primary: false,
  },
  {
    label: 'Behance',
    icon: 'behance',
    value: 'umarakbar3b98e',
    sub: 'Full portfolio & case studies',
    href: SITE.social.behance,
    external: true,
    primary: false,
  },
];
---
<BaseLayout {title} {description} {locale} path="/contact" {jsonLd}>
  <PageHero
    title="Let's discuss your project."
    lead="A short brief of your needs helps us provide accurate estimates. For fastest reply, use WhatsApp."
  >
    <div class="mt-10 flex flex-wrap gap-3">
      <a href={SITE.whatsapp} target="_blank" rel="noopener" class="km-btn-lime">
        <Icon name="whatsapp" size={18} />
        Chat on WhatsApp
      </a>
      <a href="/en#brief" class="km-btn-ghost">Auto-generate a brief</a>
    </div>
  </PageHero>

  <section class="relative py-12 md:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-4 sm:grid-cols-3">
        {channels.map((c) => (
          <a href={c.href} {...(c.external ? { target: '_blank', rel: 'noopener' } : {})}

             class:list={['km-bento group p-5 md:p-6 flex items-start gap-4', c.primary && 'sm:col-span-3']}>
            <span class="flex-shrink-0 w-12 h-12 rounded-full border border-[var(--color-line-strong)] grid place-items-center text-white group-hover:border-[var(--color-lime)] transition-colors">
              <Icon name={c.icon} size={22} />
            </span>
            <div class="flex-1 min-w-0">
              <div class="km-label">{c.label}</div>
              <div class="mt-1 font-display font-bold text-lg md:text-xl tracking-tight break-words">{c.value}</div>
              <div class="mt-1 text-sm text-white/65">{c.sub}</div>
            </div>
            <span class="flex-shrink-0 text-white/60 group-hover:text-[var(--color-lime)] transition-colors">
              <Icon name="arrow-up-right" size={20} />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="relative py-12 md:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-2xl border border-[var(--color-line)] bg-[var(--color-ink-2)] p-6 md:p-10 grid gap-8 md:grid-cols-3 items-start">
        <div>
          <div class="km-label">Studio</div>
          <div class="mt-3 font-display font-bold text-2xl tracking-tight">{SITE.address.locality}</div>
          <div class="mt-1 text-white/60 text-sm">{SITE.address.region}, {SITE.address.countryName}</div>
        </div>
        <div>
          <div class="km-label">Hours</div>
          <div class="mt-3 font-display font-bold text-2xl tracking-tight">09:00 — 18:00 WIB</div>
          <div class="mt-1 text-white/60 text-sm">Mon–Fri, Sat by appointment</div>
        </div>
        <div>
          <div class="km-label">Coverage</div>
          <div class="mt-3 font-display font-bold text-2xl tracking-tight">Indonesia & Worldwide</div>
          <div class="mt-1 text-white/60 text-sm">Remote-first, on-site by request</div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
