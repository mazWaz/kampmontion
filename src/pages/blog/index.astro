---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config/site';
import { organizationSchema, breadcrumb } from '../../lib/schema';

const locale = 'id' as const;
const title = 'Blog — Insight Motion Graphic, Animasi & AI';
const description = 'Artikel dan insight seputar motion graphic, animasi 2D, video produksi, dan workflow AI dari tim Kamp Motion Studio.';
const jsonLd = [
  organizationSchema(locale),
  breadcrumb([
    { name: 'Beranda', url: SITE.url + '/' },
    { name: 'Blog', url: SITE.url + '/blog' },
  ]),
];

const upcoming = [
  { title: 'Beda Animasi 2D dan Motion Graphic, Mana yang Cocok untuk Brand Anda?', slug: 'beda-animasi-2d-motion-graphic' },
  { title: 'Cara AI Mempercepat Produksi Video Tanpa Mengorbankan Kualitas', slug: 'ai-mempercepat-produksi-video' },
  { title: 'Panduan Memilih Jasa Motion Graphic untuk Startup', slug: 'memilih-jasa-motion-graphic-startup' },
  { title: 'Anatomi Video Company Profile yang Menjual', slug: 'anatomi-video-company-profile' },
];
---
<BaseLayout {title} {description} {locale} path="/blog" {jsonLd}>
  <section class="bg-[var(--color-ink-2)] text-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="text-sm uppercase tracking-widest text-[var(--color-lime)]">Blog</p>
      <h1 class="mt-3 font-display text-4xl md:text-6xl font-bold">Insight & Inspirasi</h1>
      <p class="mt-4 max-w-2xl text-white/70">Edukasi dan refleksi dari pengalaman kami menggabungkan kreativitas dengan AI.</p>
    </div>
  </section>
  <section class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-16">
    <h2 class="font-display text-2xl font-bold">Akan Datang</h2>
    <ul class="mt-6 space-y-3">
      {upcoming.map((u) => (
        <li class="p-5 rounded-xl border border-[var(--color-line)] bg-[var(--color-ink-2)]">
          <span class="text-xs uppercase tracking-wider text-white/40">Coming soon</span>
          <div class="mt-1 font-display font-bold text-lg">{u.title}</div>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
