---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import UXEnhancers from '../components/UXEnhancers.astro';
import type { Locale } from '../config/site';

export interface Props {
  title: string;
  description: string;
  locale: Locale;
  path: string;
  ogImage?: string;
  jsonLd?: unknown[];
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { title, description, locale, path, ogImage, jsonLd, type, noindex } = Astro.props;
const htmlLang = locale === 'id' ? 'id-ID' : 'en-US';
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <SEO {title} {description} {locale} {path} {ogImage} {jsonLd} {type} {noindex} />
    <ClientRouter fallback="swap" />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header locale={locale} currentPath={Astro.url.pathname} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <UXEnhancers locale={locale} />
  </body>
</html>

<style is:global>
  /* View Transitions — cinematic crossfade + slight slide */
  @view-transition { navigation: auto; }
  ::view-transition-old(root) { animation: kmFadeOut .25s ease forwards; }
  ::view-transition-new(root) { animation: kmFadeIn .35s ease .05s both; }
  @keyframes kmFadeOut { to { opacity: 0; transform: translateY(-8px); } }
  @keyframes kmFadeIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(root), ::view-transition-new(root) { animation: none; }
  }
</style>
