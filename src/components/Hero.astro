---
import { t, localizedPath } from '../i18n/ui';
import type { Locale } from '../config/site';
import WorkReel from './WorkReel.astro';
export interface Props { locale: Locale }
const { locale } = Astro.props;
---
<section class="relative pt-20 md:pt-28 pb-16 md:pb-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <h1 class="km-h1 max-w-5xl">
      {locale === 'id' ? 'Tempat imajinasi menjadi hidup.' : 'Where imagination comes to life.'}
    </h1>
    <div class="mt-10 grid gap-8 md:grid-cols-[1fr_auto] md:items-end">
      <p class="text-lg md:text-xl max-w-xl text-white/70 leading-relaxed">{t(locale, 'home.heroLead')}</p>
      <div class="flex flex-wrap gap-3">
        <a href="#brief" class="km-btn-lime">{locale === 'id' ? 'Buat brief otomatis' : 'Auto-generate a brief'}</a>
        <a href={localizedPath(locale, '/portfolio')} class="km-btn-ghost">{t(locale, 'cta.viewWork')}</a>
      </div>
    </div>
  </div>
  <div class="mt-14 md:mt-20">
    <WorkReel locale={locale} />
  </div>
</section>
