---
import { t, localizedPath } from '../i18n/ui';
import type { Locale } from '../config/site';
import { SITE } from '../config/site';
import { services } from '../data/services';
import { regionsFor, regionPath } from '../data/regions';
import Icon from './Icon.astro';
export interface Props { locale: Locale }
const { locale } = Astro.props;
const year = new Date().getFullYear();
const id = locale === 'id';

const social = [
  { href: SITE.social.instagram, label: 'Instagram', icon: 'instagram' },
  { href: SITE.social.behance, label: 'Behance', icon: 'behance' },
  { href: SITE.social.fastwork, label: 'Fastwork', icon: 'bolt' },
];
const studio = [
  { href: id ? '/tentang' : '/en/about', label: t(locale, 'nav.about') },
  { href: localizedPath(locale, '/portfolio'), label: t(locale, 'nav.portfolio') },
  { href: id ? '/kontak' : '/en/contact', label: t(locale, 'nav.contact') },
];
const linkClass = 'km-link text-white/70 hover:text-white';
const areas = regionsFor(locale);
// Comma list ending in "dan"/"and": Jakarta, Bali, dan Jawa Timur.
const sep = (i: number) => (i < areas.length - 2 ? ', ' : i === areas.length - 2 ? (id ? ', dan ' : ', and ') : '');
---
<footer class="border-t border-[var(--color-line)] mt-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-20 pb-10">
    <div class="grid gap-12 md:grid-cols-12">
      <div class="md:col-span-4">
        <div class="font-display text-5xl md:text-7xl font-bold tracking-tight">
          Kamp <span class="text-[var(--color-lime)]">Motion.</span>
        </div>
        <p class="mt-4 max-w-md text-white/65">{SITE.tagline[locale]}</p>
        <ul class="mt-8 flex flex-wrap gap-2">
          {social.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener" class="km-btn-ghost text-sm py-2 px-4">
                <Icon name={s.icon} size={16} />
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <nav class="md:col-span-3" aria-labelledby="ft-services">
        <h2 id="ft-services" class="km-label mb-4">
          <a href={id ? '/layanan' : '/en/services'} class="hover:text-white">{t(locale, 'nav.services')}</a>
        </h2>
        <ul class="space-y-2.5 text-sm">
          {services.map((s) => (
            <li><a class={linkClass} href={id ? `/layanan/${s.slug}` : `/en/services/${s.slugEn}`}>{s.title[locale]}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="md:col-span-2" aria-labelledby="ft-studio">
        <h2 id="ft-studio" class="km-label mb-4">Studio</h2>
        <ul class="space-y-2.5 text-sm">
          {studio.map((l) => <li><a class={linkClass} href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>

      <div class="md:col-span-3">
        <h2 class="km-label mb-4">{id ? 'Hubungi' : 'Get in touch'}</h2>
        <ul class="space-y-2.5 text-sm">
          <li><a class={linkClass} href={SITE.whatsapp} target="_blank" rel="noopener">{SITE.phoneDisplay}</a></li>
          <li><a class={linkClass} href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li class="text-white/60">{SITE.address.locality}, {SITE.address.countryName}</li>
        </ul>
        <p class="mt-6 text-sm text-white/60 leading-relaxed">
          {id ? 'Melayani klien di ' : 'Working with clients in '}
          {areas.map((r, i) => <><a class={linkClass} href={regionPath(r)}>{r.name ?? r.label}</a>{sep(i)}</>)}.
        </p>
      </div>
    </div>

    <div class="mt-16 pt-6 border-t border-[var(--color-line)] text-xs text-white/60">
      © {year} {SITE.name}. {t(locale, 'footer.rights')}
    </div>
  </div>
</footer>
