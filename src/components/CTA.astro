---
import { t } from '../i18n/ui';
import { SITE } from '../config/site';
import type { Locale } from '../config/site';
export interface Props { locale: Locale }
const { locale } = Astro.props;
---
<section class="relative py-24 md:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="relative overflow-hidden rounded-3xl border border-[var(--color-line-strong)] p-10 md:p-20 bg-[var(--color-ink-2)]">
      <div class="km-aurora"></div>
      <div class="relative z-[2] max-w-3xl">
        <span class="km-eyebrow">08 · {locale === 'id' ? 'Mulai Sekarang' : 'Start Now'}</span>
        <h2 class="km-h1 mt-6">
          {locale === 'id' ? <>Bawa cerita Anda <em>hidup</em>.</> : <>Bring your story <em>to life</em>.</>}
        </h2>
        <p class="mt-6 text-lg text-white/70 max-w-xl">{t(locale,'home.ctaLead')}</p>
        <div class="mt-10 flex flex-wrap gap-3">
          <a href={SITE.whatsapp} target="_blank" rel="noopener" data-magnetic="0.3" data-cursor="link" class="km-btn-lime">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.5 8.5 0 1 1 17.1-3.8z"/></svg>
            {t(locale,'cta.discuss')}
          </a>
          <a href={`mailto:${SITE.email}`} data-cursor="link" class="km-btn-ghost">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            {SITE.email}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
