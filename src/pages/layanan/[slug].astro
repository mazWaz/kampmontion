---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTA from '../../components/CTA.astro';
import Icon from '../../components/Icon.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import ServiceGallery from '../../components/ServiceGallery.astro';
import { services } from '../../data/services';
import { SITE } from '../../config/site';
import { organizationSchema, breadcrumb, faqSchema } from '../../lib/schema';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}

const { service } = Astro.props;
const locale = 'id' as const;
const title = `Jasa ${service.title.id} Jogja & Indonesia | Kamp Motion`;
const description = `${service.short.id} Berbasis di Jogja, melayani seluruh Indonesia.`;
const url = `${SITE.url}/layanan/${service.slug}`;

const faqs = [
  { question: `Berapa lama proses pengerjaan ${service.title.id}?`, answer: 'Bergantung kompleksitas: 5–14 hari kerja untuk proyek standar, 2–6 minggu untuk proyek besar atau kustom.' },
  { question: `Apakah ${service.title.id} sudah termasuk revisi?`, answer: 'Ya, setiap paket termasuk revisi sesuai scope yang disepakati. Revisi tambahan tersedia dengan biaya proporsional.' },
  { question: 'Apakah Kamp Motion bisa menangani proyek internasional?', answer: 'Tentu. Kami sudah melayani klien lokal dan internasional dengan komunikasi via email, WhatsApp, atau video call.' },
  { question: 'Bagaimana sistem pembayaran proyek?', answer: 'Standar industri: 50% di awal sebagai DP setelah brief disepakati, 50% setelah delivery final. Untuk paket langganan, billing dilakukan bulanan.' },
];

const related = services.filter((s) => s.slug !== service.slug).slice(0, 3);

const jsonLd = [
  organizationSchema(locale),
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: service.title.id,
    serviceType: service.title.id,
    description: service.long.id,
    provider: { '@id': `${SITE.url}#organization` },
    areaServed: ['Indonesia', 'Worldwide'],
    url,
    offers: { '@type': 'Offer', priceCurrency: 'IDR', availability: 'https://schema.org/InStock' },
  },
  faqSchema(faqs),
  breadcrumb([
    { name: 'Beranda', url: SITE.url + '/' },
    { name: 'Layanan', url: SITE.url + '/layanan' },
    { name: service.title.id, url },
  ]),
];
---
<BaseLayout {title} {description} {locale} path={`/layanan/${service.slug}`} {jsonLd}>
  <PageHero back={{ href: '/layanan', label: 'Semua layanan' }} title={service.title.id} lead={service.short.id}>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href={SITE.whatsapp} target="_blank" rel="noopener" class="km-btn-lime">
        <Icon name="whatsapp" size={18} />
        Diskusi via WhatsApp
      </a>
      <a href="/#brief" class="km-btn-ghost">Buat brief otomatis</a>
    </div>
  </PageHero>

  <div class="relative">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <VideoEmbed id={service.youtubeId} title={`${service.title.id} — Kamp Motion Studio`} />
    </div>
  </div>

  <section class="relative py-20 md:py-28 border-t border-[var(--color-line)]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 grid lg:grid-cols-[1.4fr_1fr] gap-10 lg:gap-16">
      <article class="order-2 lg:order-1">
        <h2 class="km-h2">
          Apa yang kami kerjakan
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-white/75">{service.long.id}</p>
      </article>

      <aside class="order-1 lg:order-2 lg:sticky lg:top-24 self-start">
        <div class="rounded-2xl border border-[var(--color-line)] bg-[var(--color-ink-2)] p-6 md:p-8">
          <div class="km-label">Yang Anda dapatkan</div>
          <ul class="mt-5 space-y-3">
            {service.deliverables.id.map((d: string) => (
              <li class="flex gap-3 text-sm text-white/85 leading-relaxed">
                <Icon name="check" size={18} class="mt-0.5 flex-shrink-0 text-[var(--color-lime)]" />
                <span>{d}</span>
              </li>
            ))}
          </ul>
          <div class="mt-6 pt-5 border-t border-[var(--color-line)] text-sm text-white/65">
            Estimasi standar 2–3 minggu kerja. Detail timeline disesuaikan brief.
          </div>
        </div>
      </aside>
    </div>
  </section>

  <ServiceGallery slug={service.slug} title={service.title.id} locale={locale} />

  <section class="relative py-20 md:py-28 border-t border-[var(--color-line)]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="km-h2 max-w-2xl">
        Pertanyaan umum.
      </h2>
      <div class="mt-10 grid gap-3 max-w-3xl">
        {faqs.map((f) => (
          <details class="group rounded-2xl border border-[var(--color-line)] bg-[var(--color-ink-2)] open:border-[var(--color-line-strong)] transition-colors">
            <summary class="cursor-pointer list-none p-5 md:p-6 flex items-center justify-between gap-4 font-display font-semibold text-base md:text-lg">
              <span>{f.question}</span>
              <span class="flex-shrink-0 w-8 h-8 rounded-full border border-[var(--color-line-strong)] grid place-items-center transition group-open:border-white/40">
                <Icon name="plus" size={14} class="transition-transform group-open:rotate-45" />
              </span>
            </summary>
            <p class="px-5 md:px-6 pb-5 md:pb-6 text-white/70 leading-relaxed">{f.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="relative py-20 md:py-28 border-t border-[var(--color-line)]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between gap-6 mb-10 flex-wrap">
        <h2 class="km-h2 max-w-2xl">
          Layanan terkait.
        </h2>
        <a href="/layanan" class="km-link text-sm text-white/70 hover:text-white">Semua layanan</a>
      </div>
      <div class="grid gap-x-5 gap-y-10 md:grid-cols-3">
        {related.map((r) => (
          <a href={`/layanan/${r.slug}`} class="group block">
            <div>
              <img src={r.image} alt="" class="aspect-video w-full object-cover rounded-2xl border border-[var(--color-line)] bg-[var(--color-ink-3)] group-hover:border-[var(--color-lime)] transition-colors" width="1200" height="675" loading="lazy" />
            </div>
            <div class="pt-4">
              <h3 class="font-display font-bold text-lg tracking-tight group-hover:text-[var(--color-lime)] transition-colors">{r.title.id}</h3>
              <p class="mt-1 text-sm text-white/65 line-clamp-2">{r.short.id}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTA locale={locale} />
</BaseLayout>
