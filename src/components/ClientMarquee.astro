---
import type { Locale } from '../config/site';
export interface Props { locale: Locale }
const { locale } = Astro.props;
const labels = ['Banking', 'Tech Startup', 'EdTech', 'Healthcare', 'NGO', 'Government', 'F&B', 'Retail', 'Fintech', 'SaaS', 'Media', 'Hospitality'];
const sym = '✦';
---
<section class="relative py-12 border-y border-[var(--color-line)] overflow-hidden">
  <p class="relative z-[2] text-center text-[10px] sm:text-xs font-display uppercase tracking-[0.3em] text-white/60 mb-8 px-4">
    {locale === 'id' ? '50+ klien · 7 tahun · Indonesia & Internasional' : '50+ clients · 7 years · Indonesia & Worldwide'}
  </p>
  <div class="km-marquee">
    <div class="km-marquee-track">
      {[...labels, ...labels].map((l) => (
        <div class="flex items-center gap-4 px-2">
          <span class="text-[var(--color-lime)] text-2xl md:text-3xl">{sym}</span>
          <span class="font-display font-bold text-3xl md:text-5xl text-white/15 hover:text-white transition-colors duration-300 tracking-tight">{l}</span>
        </div>
      ))}
    </div>
  </div>
</section>
