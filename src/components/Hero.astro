---
import { t } from '../i18n/ui';
import type { Locale } from '../config/site';
export interface Props { locale: Locale }
const { locale } = Astro.props;

const t1 = locale === 'id' ? 'Where' : 'Where';
const t2 = locale === 'id' ? 'Imagination' : 'Imagination';
const t3 = locale === 'id' ? 'Comes' : 'Comes';
const t4 = locale === 'id' ? 'to Life.' : 'to Life.';
---
<section class="relative isolate overflow-hidden min-h-[92vh] flex items-center">
  <div class="km-aurora"></div>

  <div class="relative z-[2] mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-24 md:py-32 w-full">
    <div class="flex flex-col gap-3 mb-8">
      <span class="km-eyebrow">2025 · KAMP MOTION STUDIO</span>
    </div>

    <h1 class="km-h1">
      <span class="block">{t1}</span>
      <span class="block"><em>{t2}</em></span>
      <span class="block opacity-90">{t3} <em>{t4}</em></span>
    </h1>

    <div class="mt-12 grid md:grid-cols-[1.6fr_1fr] gap-10 items-end">
      <p class="text-lg md:text-xl max-w-xl text-white/70 leading-relaxed">
        {t(locale, 'home.heroLead')}
      </p>

      <div class="flex flex-wrap gap-3 md:justify-end">
        <a href="#brief" data-magnetic="0.3" data-cursor="link" class="km-btn-lime">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.9 4.6L18.5 9.5l-4.6 1.9L12 16l-1.9-4.6L5.5 9.5l4.6-1.9z"/></svg>
          {locale === 'id' ? 'Buat Brief Otomatis' : 'Auto-Generate Brief'}
        </a>
        <a href={locale==='id'?'/portfolio':'/en/portfolio'} data-cursor="play" class="km-btn-ghost">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="6 4 20 12 6 20 6 4"/></svg>
          {t(locale,'cta.viewWork')}
        </a>
      </div>
    </div>

    <dl class="mt-20 grid grid-cols-3 gap-6 max-w-2xl border-t border-[var(--color-line)] pt-8">
      <div>
        <dt class="font-display text-4xl md:text-6xl font-bold text-[var(--color-lime)] tracking-tight">7+</dt>
        <dd class="text-xs uppercase tracking-widest text-white/50 mt-2">{t(locale,'home.statsYears')}</dd>
      </div>
      <div>
        <dt class="font-display text-4xl md:text-6xl font-bold text-[var(--color-lime)] tracking-tight">50+</dt>
        <dd class="text-xs uppercase tracking-widest text-white/50 mt-2">{t(locale,'home.statsClients')}</dd>
      </div>
      <div>
        <dt class="font-display text-4xl md:text-6xl font-bold text-[var(--color-lime)] tracking-tight">8</dt>
        <dd class="text-xs uppercase tracking-widest text-white/50 mt-2">{t(locale,'home.statsServices')}</dd>
      </div>
    </dl>
  </div>

  <!-- corner mark -->
  <div class="absolute top-24 right-6 z-[2] hidden md:flex items-start gap-2 text-white/40 text-xs uppercase tracking-widest">
    <span>2D · MOTION · AI</span>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
  </div>
</section>
