---
import { t } from '../i18n/ui';
import type { Locale } from '../config/site';
export interface Props { locale: Locale }
const { locale } = Astro.props;
const steps = [
  { n: '01', titleKey: 'process.research' as const, descKey: 'process.researchDesc' as const },
  { n: '02', titleKey: 'process.storyboard' as const, descKey: 'process.storyboardDesc' as const },
  { n: '03', titleKey: 'process.production' as const, descKey: 'process.productionDesc' as const },
  { n: '04', titleKey: 'process.delivery' as const, descKey: 'process.deliveryDesc' as const },
];
---
<section class="relative py-24 md:py-32 border-y border-[var(--color-line)]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex items-end justify-between gap-6 mb-12 flex-wrap">
      <div>
        <h2 class="km-h2 mt-4 max-w-2xl">
          {locale === 'id' ? <>Empat tahap. <em>Disiplin</em>. Cepat.</> : <>Four stages. <em>Disciplined</em>. Fast.</>}
        </h2>
      </div>
    </div>

    <div class="grid gap-px bg-[var(--color-line)] border border-[var(--color-line)] rounded-2xl overflow-hidden md:grid-cols-2 lg:grid-cols-4">
      {steps.map((s) => (
        <div class="bg-[var(--color-ink)] p-8 hover:bg-[var(--color-ink-2)] transition">
          <div class="flex items-baseline gap-3">
            <span class="font-display text-5xl font-bold text-[var(--color-lime)] tracking-tight">{s.n}</span>
            <span class="h-px flex-1 bg-[var(--color-line)]"></span>
          </div>
          <h3 class="mt-6 font-display font-bold text-xl tracking-tight">{t(locale, s.titleKey)}</h3>
          <p class="mt-3 text-sm text-white/55 leading-relaxed">{t(locale, s.descKey)}</p>
        </div>
      ))}
    </div>
  </div>
</section>
