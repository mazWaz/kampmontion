---
import { projects } from '../data/portfolio';
import type { Locale } from '../config/site';
import { localizedPath } from '../i18n/ui';
import ProjectCard from './ProjectCard.astro';
export interface Props { locale: Locale }
const { locale } = Astro.props;
---
<section class="relative py-24 md:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-end justify-between gap-6 mb-12">
      <h2 class="km-h2 max-w-2xl">{locale === 'id' ? 'Karya terpilih.' : 'Selected work.'}</h2>
      <a href={localizedPath(locale, '/portfolio')} class="km-link text-sm text-white/70 hover:text-white">
        {locale === 'id' ? `Lihat semua ${projects.length} proyek` : `See all ${projects.length} projects`}
      </a>
    </div>
    <div class="grid gap-x-5 gap-y-12 md:grid-cols-3">
      {projects.slice(0, 3).map((p) => <ProjectCard project={p} {locale} />)}
    </div>
  </div>
</section>
