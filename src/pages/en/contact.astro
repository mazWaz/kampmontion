---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { SITE } from '../../config/site';
import { organizationSchema, breadcrumb } from '../../lib/schema';

const locale = 'en' as const;
const title = 'Contact — Start Your Project';
const description = `Contact Kamp Motion Studio at ${SITE.email} or WhatsApp ${SITE.phoneDisplay} for motion graphic, 2D animation, and video production projects.`;
const jsonLd = [
  organizationSchema(locale),
  breadcrumb([
    { name: 'Home', url: SITE.url + '/en' },
    { name: 'Contact', url: SITE.url + '/en/contact' },
  ]),
  { '@context': 'https://schema.org', '@type': 'ContactPage', name: 'Contact Kamp Motion', url: SITE.url + '/en/contact' },
];

const channels = [
  {
    label: 'WhatsApp',
    value: SITE.phoneDisplay,
    sub: 'Reply within 1–6 hours on business days',
    href: SITE.whatsapp,
    external: true,
    primary: true,
    svg: '<path d="M22 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.5 8.5 0 1 1 17.1-3.8z"/>',
  },
  {
    label: 'Email',
    value: SITE.email,
    sub: 'For full briefs & attachments',
    href: `mailto:${SITE.email}`,
    external: false,
    primary: false,
    svg: '<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>',
  },
  {
    label: 'Instagram',
    value: '@kamp_motion',
    sub: 'Latest work & behind-the-scenes',
    href: SITE.social.instagram,
    external: true,
    primary: false,
    svg: '<rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>',
  },
  {
    label: 'Behance',
    value: 'umarakbar3b98e',
    sub: 'Full portfolio & case studies',
    href: SITE.social.behance,
    external: true,
    primary: false,
    svg: '<path d="M2 7h6a3 3 0 1 1 0 6H2zM2 13h7a3 3 0 1 1 0 6H2zM14 9h6M14 14h7c0-2-1.5-4-3.5-4S14 12 14 14z"/>',
  },
];
---
<BaseLayout {title} {description} {locale} path="/contact" {jsonLd}>
  <PageHero
    kicker="Contact"
    title="Let's discuss your *project*."
    lead="A short brief of your needs helps us provide accurate estimates. For fastest reply, use WhatsApp."
  >
    <div class="mt-10 flex flex-wrap gap-3">
      <a href={SITE.whatsapp} target="_blank" rel="noopener" data-magnetic="0.25" data-cursor="link" class="km-btn-lime">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.5 8.5 0 1 1 17.1-3.8z"/></svg>
        Chat on WhatsApp
      </a>
      <a href="/en/#brief" data-cursor="link" class="km-btn-ghost">Auto-Generate Brief</a>
    </div>
  </PageHero>

  <section class="relative py-12 md:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-4 sm:grid-cols-2">
        {channels.map((c) => (
          <a href={c.href} {...(c.external ? { target: '_blank', rel: 'noopener' } : {})}
             data-spotlight data-cursor="link"
             class:list={['km-bento p-6 md:p-8 flex items-start gap-5', c.primary && 'md:col-span-2 sm:col-span-2']}>
            <span class="flex-shrink-0 w-12 h-12 rounded-2xl border border-[var(--color-line-strong)] grid place-items-center text-[var(--color-lime)] group-hover:bg-[var(--color-lime)] group-hover:text-[#0a0a0b] transition">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={c.svg}></svg>
            </span>
            <div class="flex-1 min-w-0">
              <div class="text-xs font-display uppercase tracking-widest text-[var(--color-lime)]">{c.label}</div>
              <div class="mt-1 font-display font-bold text-xl md:text-2xl tracking-tight truncate">{c.value}</div>
              <div class="mt-1 text-sm text-white/55">{c.sub}</div>
            </div>
            <span class="flex-shrink-0 self-center text-white/40 group-hover:text-[var(--color-lime)] transition">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="relative py-12 md:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-3xl border border-[var(--color-line)] bg-[var(--color-ink-2)] p-6 md:p-10 grid gap-8 md:grid-cols-3 items-start">
        <div>
          <div class="text-xs font-display uppercase tracking-widest text-[var(--color-lime)]">Studio</div>
          <div class="mt-3 font-display font-bold text-2xl tracking-tight">{SITE.address.locality}</div>
          <div class="mt-1 text-white/60 text-sm">{SITE.address.region}, {SITE.address.countryName}</div>
        </div>
        <div>
          <div class="text-xs font-display uppercase tracking-widest text-[var(--color-lime)]">Hours</div>
          <div class="mt-3 font-display font-bold text-2xl tracking-tight">09:00 — 18:00 WIB</div>
          <div class="mt-1 text-white/60 text-sm">Mon–Fri · Sat by appointment</div>
        </div>
        <div>
          <div class="text-xs font-display uppercase tracking-widest text-[var(--color-lime)]">Coverage</div>
          <div class="mt-3 font-display font-bold text-2xl tracking-tight">Indonesia & Worldwide</div>
          <div class="mt-1 text-white/60 text-sm">Remote-first, on-site by request</div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
