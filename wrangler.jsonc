// Static Astro site served as Workers static assets. Having this file stops
// Cloudflare's autoconfig from running `astro add cloudflare`, whose latest
// adapter added an SSR adapter this static site does not need and broke the build.
{
  "name": "kampmontion",
  "compatibility_date": "2026-11-19",
  "build": { "command": "npm run build" },
  // Serve /page (no trailing slash) to match canonical URLs; /page/ redirects there.
  "assets": { "directory": "./dist", "html_handling": "drop-trailing-slash" }
}
