---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import CTA from '../../../components/CTA.astro';
import Icon from '../../../components/Icon.astro';
import VideoEmbed from '../../../components/VideoEmbed.astro';
import ServiceGallery from '../../../components/ServiceGallery.astro';
import { services } from '../../../data/services';
import { SITE } from '../../../config/site';
import { organizationSchema, breadcrumb, faqSchema } from '../../../lib/schema';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slugEn }, props: { service: s } }));
}

const { service } = Astro.props;
const locale = 'en' as const;
const title = `${service.title.en} — Professional Service`;
const description = service.short.en;
const url = `${SITE.url}/en/services/${service.slugEn}`;

const faqs = [
  { question: `How long does ${service.title.en} production take?`, answer: 'Depends on complexity: 5–14 business days for standard projects, 2–6 weeks for larger or custom work.' },
  { question: `Are revisions included in ${service.title.en}?`, answer: 'Yes, every package includes revisions within the agreed scope. Additional revisions are available pro-rata.' },
  { question: 'Do you serve international clients?', answer: 'Absolutely. We work with both local and international clients via email, WhatsApp, or video call.' },
  { question: 'How does payment work?', answer: 'Industry standard: 50% upfront upon brief approval, 50% on final delivery. Subscription packages are billed monthly.' },
];

const related = services.filter((s) => s.slugEn !== service.slugEn).slice(0, 3);

const jsonLd = [
  organizationSchema(locale),
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: service.title.en,
    serviceType: service.title.en,
    description: service.long.en,
    provider: { '@id': `${SITE.url}#organization` },
    areaServed: ['Indonesia', 'Worldwide'],
    url,
    offers: { '@type': 'Offer', priceCurrency: 'USD', availability: 'https://schema.org/InStock' },
  },
  faqSchema(faqs),
  breadcrumb([
    { name: 'Home', url: SITE.url + '/en' },
    { name: 'Services', url: SITE.url + '/en/services' },
    { name: service.title.en, url },
  ]),
];
---
<BaseLayout {title} {description} {locale} path={`/services/${service.slugEn}`} {jsonLd}>
  <PageHero back={{ href: '/en/services', label: 'All services' }} title={service.title.en} lead={service.short.en}>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href={SITE.whatsapp} target="_blank" rel="noopener" class="km-btn-lime">
        <Icon name="whatsapp" size={18} />
        Chat on WhatsApp
      </a>
      <a href="/en#brief" class="km-btn-ghost">Auto-generate a brief</a>
    </div>
  </PageHero>

  <div class="relative">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <VideoEmbed id={service.youtubeId} title={`${service.title.en} — Kamp Motion Studio`} />
    </div>
  </div>

  <section class="relative py-20 md:py-28 border-t border-[var(--color-line)]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 grid lg:grid-cols-[1.4fr_1fr] gap-10 lg:gap-16">
      <article class="order-2 lg:order-1">
        <h2 class="km-h2">
          What we deliver
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-white/75">{service.long.en}</p>
      </article>

      <aside class="order-1 lg:order-2 lg:sticky lg:top-24 self-start">
        <div class="rounded-2xl border border-[var(--color-line)] bg-[var(--color-ink-2)] p-6 md:p-8">
          <div class="km-label">What you get</div>
          <ul class="mt-5 space-y-3">
            {service.deliverables.en.map((d: string) => (
              <li class="flex gap-3 text-sm text-white/85 leading-relaxed">
                <Icon name="check" size={18} class="mt-0.5 flex-shrink-0 text-[var(--color-lime)]" />
                <span>{d}</span>
              </li>
            ))}
          </ul>
          <div class="mt-6 pt-5 border-t border-[var(--color-line)] text-sm text-white/65">
            Standard estimate 2–3 weeks. Timeline tailored to brief.
          </div>
        </div>
      </aside>
    </div>
  </section>

  <ServiceGallery slug={service.slug} title={service.title.en} locale={locale} />

  <section class="relative py-20 md:py-28 border-t border-[var(--color-line)]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="km-h2 max-w-2xl">
        Frequently asked.
      </h2>
      <div class="mt-10 grid gap-3 max-w-3xl">
        {faqs.map((f) => (
          <details class="group rounded-2xl border border-[var(--color-line)] bg-[var(--color-ink-2)] open:border-[var(--color-line-strong)] transition-colors">
            <summary class="cursor-pointer list-none p-5 md:p-6 flex items-center justify-between gap-4 font-display font-semibold text-base md:text-lg">
              <span>{f.question}</span>
              <span class="flex-shrink-0 w-8 h-8 rounded-full border border-[var(--color-line-strong)] grid place-items-center transition group-open:border-white/40">
                <Icon name="plus" size={14} class="transition-transform group-open:rotate-45" />
              </span>
            </summary>
            <p class="px-5 md:px-6 pb-5 md:pb-6 text-white/70 leading-relaxed">{f.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="relative py-20 md:py-28 border-t border-[var(--color-line)]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between gap-6 mb-10 flex-wrap">
        <h2 class="km-h2 max-w-2xl">
          Related services.
        </h2>
        <a href="/en/services" class="km-link text-sm text-white/70 hover:text-white">All services</a>
      </div>
      <div class="grid gap-x-5 gap-y-10 md:grid-cols-3">
        {related.map((r) => (
          <a href={`/en/services/${r.slugEn}`} class="group block">
            <div>
              <img src={r.image} alt="" class="aspect-video w-full object-cover rounded-2xl border border-[var(--color-line)] bg-[var(--color-ink-3)] group-hover:border-[var(--color-lime)] transition-colors" width="1200" height="675" loading="lazy" />
            </div>
            <div class="pt-4">
              <h3 class="font-display font-bold text-lg tracking-tight group-hover:text-[var(--color-lime)] transition-colors">{r.title.en}</h3>
              <p class="mt-1 text-sm text-white/65 line-clamp-2">{r.short.en}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTA locale={locale} />
</BaseLayout>
