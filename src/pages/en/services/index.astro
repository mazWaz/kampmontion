---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import ServicesGrid from '../../../components/ServicesGrid.astro';
import CTA from '../../../components/CTA.astro';
import { SITE } from '../../../config/site';
import { organizationSchema, breadcrumb, serviceSchema } from '../../../lib/schema';

const locale = 'en' as const;
const title = 'Motion Graphics, 2D Animation & Video Production Services';
const description = 'Kamp Motion services: company profile video, 2D animation, motion graphics, video editing, event bumpers, production house, logo animation, and VFX.';
const jsonLd = [
  organizationSchema(locale),
  ...serviceSchema(locale),
  breadcrumb([
    { name: 'Home', url: SITE.url + '/en' },
    { name: 'Services', url: SITE.url + '/en/services' },
  ]),
];
---
<BaseLayout {title} {description} {locale} path="/services" {jsonLd}>
  <PageHero
    kicker="Services"
    title="Complete *visual solutions* for modern brands."
    lead="Eight creative services blending human expertise with AI — fast, precise, and still soulful."
  />
  <ServicesGrid locale={locale} />
  <CTA locale={locale} />
</BaseLayout>
