---
import { testimonials } from '../data/testimonials';
import type { Locale } from '../config/site';
export interface Props { locale: Locale }
const { locale } = Astro.props;
---
<section class="relative py-24 md:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-end justify-between gap-6 mb-12">
      <h2 class="km-h2 max-w-2xl">{locale === 'id' ? 'Kata klien kami.' : 'What clients say.'}</h2>
      <p class="text-sm text-white/70">{locale === 'id' ? 'Rating 5,0 di Fastwork dan Sribu' : 'Rated 5.0 on Fastwork and Sribu'}</p>
    </div>

    <ul class="grid gap-x-10 gap-y-10 md:grid-cols-2 lg:grid-cols-3">
      {testimonials.map((tm) => (
        <li class="border-t border-[var(--color-line-strong)] pt-6">
          <figure>
            <blockquote class="text-lg leading-relaxed text-white/90">“{tm.quote}”</blockquote>
            <figcaption class="mt-4 text-sm text-white/60">
              {tm.author && <><span class="text-white font-medium">{tm.author}</span>, </>}{tm.role}, via {tm.source}
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>
