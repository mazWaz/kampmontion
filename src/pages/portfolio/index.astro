---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTA from '../../components/CTA.astro';
import { projects } from '../../data/portfolio';
import { SITE } from '../../config/site';
import { organizationSchema, breadcrumb } from '../../lib/schema';

const locale = 'id' as const;
const title = 'Portfolio Animasi & Motion Graphic';
const description = 'Pilihan proyek Kamp Motion Studio: animasi 2D, motion graphic, video company profile, bumper event, logo animation, dan VFX untuk brand lokal dan internasional.';
const jsonLd = [
  organizationSchema(locale),
  breadcrumb([
    { name: 'Beranda', url: SITE.url + '/' },
    { name: 'Portfolio', url: SITE.url + '/portfolio' },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    hasPart: projects.map((p) => ({
      '@type': 'CreativeWork',
      name: p.title.id,
      url: `${SITE.url}/portfolio/${p.slug}`,
    })),
  },
];
---
<BaseLayout {title} {description} {locale} path="/portfolio" {jsonLd}>
  <PageHero
    kicker="Portfolio"
    title="Karya pilihan untuk *50+* klien."
    lead="Dari fintech onboarding hingga corporate cinematic — pilihan proyek yang dapat kami tampilkan publik."
  />
  <section class="relative py-12 md:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {projects.map((p, i) => (
          <a href={`/portfolio/${p.slug}`} data-spotlight data-cursor="play"
             class="group block rounded-2xl overflow-hidden border border-[var(--color-line)] hover:border-[var(--color-lime)] bg-[var(--color-ink-2)] transition">
            <div class="aspect-video overflow-hidden bg-[var(--color-ink-3)] relative">
              <img src={p.cover} alt={p.title.id} class="w-full h-full object-cover transition duration-500 group-hover:scale-105" width="800" height="450" loading={i < 3 ? "eager" : "lazy"} />
              <div class="absolute top-3 left-3 px-2.5 py-1 rounded-full bg-black/60 backdrop-blur text-[10px] uppercase tracking-widest font-display">
                {p.year}
              </div>
            </div>
            <div class="p-5">
              <div class="text-xs uppercase tracking-widest text-[var(--color-lime)] font-display">{p.category.id}</div>
              <h2 class="mt-2 font-display font-bold text-lg tracking-tight">{p.title.id}</h2>
              <p class="mt-1 text-sm text-white/60 line-clamp-2">{p.summary.id}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  <CTA locale={locale} />
</BaseLayout>
