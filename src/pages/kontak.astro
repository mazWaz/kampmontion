---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../config/site';
import { organizationSchema, breadcrumb } from '../lib/schema';

const locale = 'id' as const;
const title = 'Kontak — Mulai Proyek Anda';
const description = `Hubungi Kamp Motion Studio di ${SITE.email} atau WhatsApp ${SITE.phoneDisplay} untuk konsultasi proyek motion graphic, animasi 2D, dan video produksi.`;
const jsonLd = [
  organizationSchema(locale),
  breadcrumb([
    { name: 'Beranda', url: SITE.url + '/' },
    { name: 'Kontak', url: SITE.url + '/kontak' },
  ]),
  { '@context': 'https://schema.org', '@type': 'ContactPage', name: 'Kontak Kamp Motion', url: SITE.url + '/kontak' },
];

const channels = [
  {
    label: 'WhatsApp',
    icon: 'whatsapp',
    value: SITE.phoneDisplay,
    sub: 'Respon 1–6 jam pada hari kerja',
    href: SITE.whatsapp,
    external: true,
    primary: true,
  },
  {
    label: 'Email',
    icon: 'mail',
    value: SITE.email,
    sub: 'Untuk brief lengkap dan lampiran',
    href: `mailto:${SITE.email}`,
    external: false,
    primary: false,
  },
  {
    label: 'Instagram',
    icon: 'instagram',
    value: '@kamp_motion',
    sub: 'Karya terbaru dan proses di balik layar',
    href: SITE.social.instagram,
    external: true,
    primary: false,
  },
  {
    label: 'Behance',
    icon: 'behance',
    value: 'umarakbar3b98e',
    sub: 'Portfolio lengkap dan studi kasus',
    href: SITE.social.behance,
    external: true,
    primary: false,
  },
];
---
<BaseLayout {title} {description} {locale} path="/kontak" {jsonLd}>
  <PageHero
    title="Mari diskusikan proyek Anda."
    lead="Cerita singkat tentang kebutuhan Anda akan membantu kami memberikan estimasi yang tepat. Untuk paling cepat, gunakan WhatsApp."
  >
    <div class="mt-10 flex flex-wrap gap-3">
      <a href={SITE.whatsapp} target="_blank" rel="noopener" class="km-btn-lime">
        <Icon name="whatsapp" size={18} />
        Chat via WhatsApp
      </a>
      <a href="/#brief" class="km-btn-ghost">Buat brief otomatis</a>
    </div>
  </PageHero>

  <section class="relative py-12 md:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-4 sm:grid-cols-3">
        {channels.map((c) => (
          <a href={c.href} {...(c.external ? { target: '_blank', rel: 'noopener' } : {})}

             class:list={['km-bento group p-5 md:p-6 flex items-start gap-4', c.primary && 'sm:col-span-3']}>
            <span class="flex-shrink-0 w-12 h-12 rounded-full border border-[var(--color-line-strong)] grid place-items-center text-white group-hover:border-[var(--color-lime)] transition-colors">
              <Icon name={c.icon} size={22} />
            </span>
            <div class="flex-1 min-w-0">
              <div class="km-label">{c.label}</div>
              <div class="mt-1 font-display font-bold text-lg md:text-xl tracking-tight break-words">{c.value}</div>
              <div class="mt-1 text-sm text-white/65">{c.sub}</div>
            </div>
            <span class="flex-shrink-0 text-white/60 group-hover:text-[var(--color-lime)] transition-colors">
              <Icon name="arrow-up-right" size={20} />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="relative py-12 md:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-2xl border border-[var(--color-line)] bg-[var(--color-ink-2)] p-6 md:p-10 grid gap-8 md:grid-cols-3 items-start">
        <div>
          <div class="km-label">Studio</div>
          <div class="mt-3 font-display font-bold text-2xl tracking-tight">{SITE.address.locality}</div>
          <div class="mt-1 text-white/60 text-sm">{SITE.address.region}, {SITE.address.countryName}</div>
        </div>
        <div>
          <div class="km-label">Jam operasional</div>
          <div class="mt-3 font-display font-bold text-2xl tracking-tight">09.00 — 18.00 WIB</div>
          <div class="mt-1 text-white/60 text-sm">Senin–Jumat, Sabtu dengan janji temu</div>
        </div>
        <div>
          <div class="km-label">Layanan</div>
          <div class="mt-3 font-display font-bold text-2xl tracking-tight">Indonesia & Internasional</div>
          <div class="mt-1 text-white/60 text-sm">Kerja jarak jauh, datang ke lokasi bila diminta</div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
