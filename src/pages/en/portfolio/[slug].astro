---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTA from '../../../components/CTA.astro';
import Icon from '../../../components/Icon.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import VideoEmbed from '../../../components/VideoEmbed.astro';
import { projects } from '../../../data/portfolio';
import { SITE } from '../../../config/site';
import { organizationSchema, breadcrumb } from '../../../lib/schema';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
const locale = 'en' as const;
const title = `${project.title.en} — ${project.category.en}`;
const description = project.summary.en;
const url = `${SITE.url}/en/portfolio/${project.slug}`;

const related = projects.filter((p) => p.slug !== project.slug).slice(0, 3);

const jsonLd = [
  organizationSchema(locale),
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: project.title.en,
    description: project.description.en,
    creator: { '@id': `${SITE.url}#organization` },
    dateCreated: project.year,
    image: `${SITE.url}${project.cover}`,
    url,
    keywords: project.tags.join(', '),
  },
  breadcrumb([
    { name: 'Home', url: SITE.url + '/en' },
    { name: 'Portfolio', url: SITE.url + '/en/portfolio' },
    { name: project.title.en, url },
  ]),
];
---
<BaseLayout {title} {description} {locale} path={`/portfolio/${project.slug}`} ogImage={project.cover} {jsonLd} type="article">
  <article>
    <section class="relative">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-20 md:pt-28 pb-12">
        <a href="/en/portfolio" class="inline-flex items-center gap-2 text-sm text-white/70 hover:text-white transition-colors">
          <Icon name="arrow-left" size={16} />
          Back to portfolio
        </a>
        <p class="mt-8 text-sm text-white/70">{[project.client, project.category.en, project.year].filter(Boolean).join(", ")}</p>
        <h1 class="km-h1 mt-3 max-w-5xl">{project.title.en}</h1>
        <p class="mt-6 max-w-2xl text-lg md:text-xl text-white/70 leading-relaxed">{project.summary.en}</p>
      </div>
    </section>

    <div class="relative">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <VideoEmbed id={project.youtubeId} title={project.title.en} />
      </div>
    </div>

    <section class="relative py-20 md:py-28">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
        <h2 class="km-h2">About the project</h2>
        <p class="mt-6 text-lg leading-relaxed text-white/80">{project.description.en}</p>
        <div class="mt-10 flex flex-wrap gap-2">
          {project.tags.map((tag) => (
            <span class="px-3 py-1.5 text-sm rounded-full border border-[var(--color-line)] text-white/80">{tag}</span>
          ))}
        </div>
        </div>
      </div>
    </section>

    <section class="relative py-16 md:py-24 border-t border-[var(--color-line)]">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex items-end justify-between gap-6 mb-10 flex-wrap">
          <h2 class="km-h2 max-w-2xl">More work.</h2>
          <a href="/en/portfolio" class="km-link text-sm text-white/70 hover:text-white">All work</a>
        </div>
        <div class="grid gap-x-5 gap-y-12 md:grid-cols-3">
          {related.map((r) => <ProjectCard project={r} {locale} />)}
        </div>
      </div>
    </section>
  </article>
  <CTA locale={locale} />
</BaseLayout>
